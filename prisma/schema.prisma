generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SearchConfig {
  id          String      @id @default(cuid())
  type        String
  name        String
  description String
  criteria    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  runs        SearchRun[]
}

model SearchRun {
  id         String        @id @default(cuid())
  configId   String?
  config     SearchConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  configName String
  configType String
  configHash String
  status     String
  stage      String
  progress   Int           @default(0)
  stats      String        @default("{}")
  limitsHit  String        @default("[]")
  warnings   String        @default("[]")
  error      String?
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  leads      Lead[]

  @@index([configId])
  @@index([status])
}

model Lead {
  id                    String        @id @default(cuid())
  runId                 String
  run                   SearchRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  url                   String
  title                 String
  source                String
  company               String
  location              String
  industry              String
  publishedAt           DateTime
  body                  String
  score                 Int
  tier                  String
  explanation           String
  evidence              String
  evaluationError       String?
  matchedOrganizationId String?
  matchedOrganization   Organization? @relation(fields: [matchedOrganizationId], references: [id], onDelete: SetNull)
  budgetUsd             Int?
  engagementType        String?
  status                String        @default("new")
  createdAt             DateTime      @default(now())

  @@unique([runId, url])
  @@index([status])
}

model Organization {
  id          String @id @default(cuid())
  name        String @unique
  description String
  services    String
  industries  String
  location    String
  leads       Lead[]
}

model CacheEntry {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}
